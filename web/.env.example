# Build-time settings for the developer console (Vite reads VITE_* when it builds).

# Where the SaanPaw API lives. Required for a real deployment, and must be https there.
VITE_API_BASE_URL=http://localhost:4001/api/v1

# Only when the console is hosted under a subpath, e.g. /console/. Leave unset for a domain root.
# VITE_BASE_PATH=/console/

# Set to 1 for a static demo with no backend: sign-in checks the demo account locally
# and the console shows sample data. Never set this for a real deployment.
# VITE_DEMO_MODE=1

# Where the landing page's "Download the app" button points. Leave unset to use the APK on
# Google Drive set in src/pages/Landing.tsx.
# VITE_APP_DOWNLOAD_URL=https://drive.google.com/uc?export=download&id=...
