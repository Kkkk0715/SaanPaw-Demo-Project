# Mobile app settings (Expo reads EXPO_PUBLIC_* when it bundles the app).

# Where the SaanPaw API lives.
#  - Local development: leave this as localhost. When the app is opened from a phone or another PC,
#    it automatically aims at the computer running Metro, so no edit is needed.
#  - Store builds: set it per build profile in eas.json, and it must be https.
EXPO_PUBLIC_API_URL=http://localhost:4001/api/v1

# Set to 1 for a static demo with no backend: sign-in checks the demo accounts locally and the
# app shows sample data. Never set this for a real build.
# EXPO_PUBLIC_DEMO_MODE=1

# Maps (location picking, Map View, radius pickers) use OpenStreetMap tiles via Leaflet - no
# token or account needed.
