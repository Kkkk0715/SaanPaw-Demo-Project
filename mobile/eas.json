{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://saan-paw-demo-project-backend-pied.vercel.app/api/v1",
        "EXPO_PUBLIC_MAPBOX_TOKEN": "$MAPBOX_TOKEN"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://saan-paw-demo-project-backend-pied.vercel.app/api/v1",
        "EXPO_PUBLIC_MAPBOX_TOKEN": "$MAPBOX_TOKEN"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
