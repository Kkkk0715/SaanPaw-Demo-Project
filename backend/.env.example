# Copy to .env for local development. See docs/DEPLOYMENT.md for production.

# Server
PORT=4001
NODE_ENV=development
# Browser origins allowed to call the API, comma separated. Empty allows any origin in development
# and none in production (native apps are not affected).
CORS_ORIGINS=
# Reverse proxies in front of the API (0 = none). Set to 1 behind nginx, Caddy or a cloud load balancer.
TRUST_PROXY=0

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/saanpaw

# Auth. Production refuses to start unless JWT_SECRET is a random string of 32+ characters
# (generate one with: openssl rand -hex 32).
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# File storage: local disk unless BLOB_READ_WRITE_TOKEN is set (Vercel injects it automatically
# once Blob storage is enabled for the project). Required on Vercel - its filesystem is ephemeral.
UPLOAD_DIR=uploads
PUBLIC_BASE_URL=http://localhost:4001
# BLOB_READ_WRITE_TOKEN=

# Smart alert defaults (metres)
DEFAULT_USER_ALERT_RADIUS=3000
DEFAULT_SHELTER_RADIUS=5000

# Moderation
MODERATION_FALSE_REPORT_BAN_THRESHOLD=3

# Email (shelter approval credentials). Left unset, these are logged instead of sent, so the rest
# of the app still works without them. Generate an App Password at myaccount.google.com/apppasswords
# (needs 2-Step Verification on the Gmail account) - not the account's own login password.
# GMAIL_USER=you@gmail.com
# GMAIL_APP_PASSWORD=

# Photo matching and the image signal in report flagging (services/gemini.service.ts). Left unset,
# both fall back to their non-AI behaviour. Free key: aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest
